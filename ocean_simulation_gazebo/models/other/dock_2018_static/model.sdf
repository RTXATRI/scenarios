            </visuals>
            <shuffle>true</shuffle>
            <robot_namespace>vrx/dock_2018_placard1</robot_namespace>
            <ros_shuffle_topic>shuffle</ros_shuffle_topic>
          </plugin>
        </visual>
        <visual name="visual_h_cross">
