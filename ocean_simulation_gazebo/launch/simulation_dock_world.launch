<launch>
    <!-- 主要参数设置 -->
    <!-- 无人机 -->
    <arg name="uav_namespace" default="uav_1"/>  <!-- 无人机命名空间 -->
    <arg name="est" default="ekf2"/>  <!-- 使用的滤波器 --> 
    <arg name="uav_vehicle" default="iris"/>  <!-- 飞行器类型 -->
    <arg name="uav_sdf" default="$(find ocean_simulation_gazebo)/models/vehicle/lite_quad_uav/model.sdf"/>  <!-- 带下视相机的 lite_quad_uav 模型，实例名仍为 uav_1 -->
    <arg name="uav_x" default="-584.75"/>  <!-- X坐标 (米) -->
    <arg name="uav_y" default="177.00"/>  <!-- Y坐标 (米) -->
    <arg name="uav_z" default="1.75"/>  <!-- Z坐标 (米) -->
    <arg name="uav_R" default="0"/>  <!-- 横滚角-Roll (度) -->
    <arg name="uav_P" default="0"/>  <!-- 俯仰角-Pitch (度) -->
    <arg name="uav_Y" default="0"/>  <!-- 航向角-Yaw (度) -->

    <!-- 无人船 -->
    <arg name="usv_namespace" default="usv_1"/>  <!-- 无人船命名空间 -->
    <arg name="usv_locked" default="false"/>  <!-- 是否锁定无人船位置 -->
    <arg name="thrust_config" default="H"/>  <!-- 无人船命名空间 -->
    <arg name="vrx_sensors_enabled" default="true"/>  <!-- 推进器配置: H/T/X -->
    <arg name="usv_x" default="-570"/>  <!-- X坐标 (米) -->
    <arg name="usv_y" default="167"/>  <!-- Y坐标 (米) -->
    <arg name="usv_z" default="0.1"/>  <!-- Z坐标 (米) -->
    <arg name="usv_roll" default="0"/>  <!-- 横滚角-Roll (度) -->
    <arg name="usv_pitch" default="0"/>  <!-- 俯仰角-Pitch (度) -->
    <arg name="usv_yaw" default="1"/>  <!-- 航向角-Yaw (度) -->

    <!-- PX4 设置 -->
    <arg name="interactive" default="true"/>  <!-- 以交互模式运行 -->

    <!-- gazebo 设置 -->
    <arg name="world" default="$(find ocean_simulation_gazebo)/worlds/extra/ocean_dock2.world" />  <!-- 要加载的Gazebo世界文件 -->
    <arg name="gui" default="true"/>  <!-- 启动GUI -->
    <arg name="debug" default="false"/>  <!-- 以调试模式启动Gazebo -->
    <arg name="verbose" default="false"/>  <!-- 只显示重要信息和错误 -->
    <arg name="paused" default="false"/>  <!-- 启动后立即开始仿真 -->
    <arg name="respawn_gazebo" default="false"/>  <!-- Gazebo崩溃不进行自动重启 -->

    <!-- MAVROS 设置 -->
    <arg name="gcs_url" default=""/>  <!-- 地面站链接（SITL模式由仿真环境提供，此处留空） -->
    <arg name="fcu_url" default="udp://:14540@localhost:14557"/>  <!-- 飞控通信链接 -->
    <arg name="respawn_mavros" default="false"/>  <!-- 进程管理 -->


    <!-- Model resources belong to this simulation package; PX4 keeps its iris airframe. -->
    <env name="GAZEBO_MODEL_PATH"
         value="$(find ocean_simulation_gazebo)/models/vehicle:$(find px4)/Tools/simulation/gazebo-classic/sitl_gazebo-classic/models:$(optenv GAZEBO_MODEL_PATH)"/>
    <env name="GAZEBO_PLUGIN_PATH"
         value="$(find px4)/build/px4_sitl_default/build_gazebo-classic:$(optenv GAZEBO_PLUGIN_PATH)"/>
    <env name="LD_LIBRARY_PATH"
         value="$(find px4)/build/px4_sitl_default/build_gazebo-classic:$(optenv LD_LIBRARY_PATH)"/>

    <!-- ========== 启动PX4 SITL CORE ========== -->
    <include file="$(find ocean_simulation_gazebo)/launch/core/px4_sitl_core.launch">
        <arg name="vehicle" value="$(arg uav_vehicle)"/>
        <arg name="interactive" value="$(arg interactive)"/>
    </include>

    <!-- ========== 启动USV CORE ========== -->
    <include file="$(find ocean_simulation_gazebo)/launch/core/usv_spawn.launch">
        <arg name="usv_namespace" value="$(arg usv_namespace)"/>
        <arg name="usv_locked" value="$(arg usv_locked)"/>
        <arg name="thrust_config" value="$(arg thrust_config)"/>
        <arg name="vrx_sensors_enabled" value="$(arg vrx_sensors_enabled)"/>
        <arg name="usv_x" value="$(arg usv_x)"/>
        <arg name="usv_y" value="$(arg usv_y)"/>
        <arg name="usv_z" value="$(arg usv_z)"/>
        <arg name="usv_roll" value="$(arg usv_roll)"/>
        <arg name="usv_pitch" value="$(arg usv_pitch)"/>
        <arg name="usv_yaw" value="$(arg usv_yaw)"/>
    </include>

    <!-- ========== 启动GAZEBO ========== -->
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name" value="$(arg world)"/>
        <arg name="debug" value="$(arg debug)"/>
        <arg name="verbose" value="$(arg verbose)"/>
        <arg name="paused" value="$(arg paused)"/>
        <arg name="gui" value="$(arg gui)" />
        <arg name="respawn_gazebo" value="$(arg respawn_gazebo)"/>
    </include>

    <!-- ========== 启动MAVROS ========== -->
    <group ns="$(arg uav_namespace)">
        <include file="$(find mavros)/launch/px4.launch">
            <arg name="gcs_url" value="$(arg gcs_url)"/>
            <arg name="fcu_url" value="$(arg fcu_url)"/>
            <arg name="respawn_mavros" value="$(arg respawn_mavros)"/>
        </include>
    </group>

    <!-- ========== 放置模型 ========== -->
    <node name="$(anon vehicle_spawn)" pkg="gazebo_ros" type="spawn_model" output="screen" 
        args="-sdf -file $(arg uav_sdf) -model $(arg uav_namespace) 
        -x $(arg uav_x) -y $(arg uav_y) -z $(arg uav_z) 
        -R $(arg uav_R) -P $(arg uav_P) -Y $(arg uav_Y)"/>                                            

</launch>
