<?xml version="1.0"?>
<!--
    Empty-world UAV simulation.

    Starts PX4 SITL, Gazebo empty world, an Iris UAV with a downward FPV
    camera, and a ground AprilTag marker. MAVROS and USV are intentionally
    not started by this launch file.
-->
<launch>
    <!-- Keep empty-world Gazebo model lookup local and deterministic. -->
    <env name="GAZEBO_MODEL_PATH"
         value="$(find ocean_simulation_gazebo)/models/vehicle:$(find ocean_simulation_gazebo)/models/sensor:$(find ocean_simulation_gazebo)/models/other:$(find ocean_simulation_gazebo)/models/px4_default:$(optenv GAZEBO_MODEL_PATH)"/>
    <env name="GAZEBO_MODEL_DATABASE_URI" value="file://$(find ocean_simulation_gazebo)/models"/>

    <!-- UAV settings -->
    <arg name="uav_namespace" default="uav_1"/>
    <arg name="uav_vehicle" default="iris"/>
    <arg name="uav_sdf" default="$(find ocean_simulation_gazebo)/models/vehicle/iris_fusion/iris_fusion.sdf"/>
    <arg name="uav_x" default="0"/>
    <arg name="uav_y" default="0"/>
    <arg name="uav_z" default="0.2"/>
    <arg name="uav_R" default="0"/>
    <arg name="uav_P" default="0"/>
    <arg name="uav_Y" default="0"/>

    <!-- AprilTag marker settings -->
    <arg name="qr_model" default="apriltag_3"/>
    <arg name="qr_sdf" default="$(find ocean_simulation_gazebo)/models/other/apriltag_3/model.sdf"/>
    <arg name="qr_x" default="5"/>
    <arg name="qr_y" default="5"/>
    <arg name="qr_z" default="0.055"/>
    <arg name="qr_R" default="0"/>
    <arg name="qr_P" default="0"/>
    <arg name="qr_Y" default="0"/>

    <!-- PX4 settings -->
    <arg name="interactive" default="false"/>

    <!-- Gazebo settings -->
    <arg name="world" default="$(find ocean_simulation_gazebo)/worlds/extra/empty_marker.world"/>
    <arg name="gui" default="true"/>
    <arg name="debug" default="false"/>
    <arg name="verbose" default="false"/>
    <arg name="paused" default="false"/>
    <arg name="respawn_gazebo" default="false"/>

    <!-- Start PX4 SITL only. MAVROS is intentionally not launched here. -->
    <include file="$(find ocean_simulation_gazebo)/launch/core/px4_sitl_core.launch">
        <arg name="vehicle" value="$(arg uav_vehicle)"/>
        <arg name="interactive" value="$(arg interactive)"/>
    </include>

    <!-- Start Gazebo with the PX4 empty world. -->
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name" value="$(arg world)"/>
        <arg name="debug" value="$(arg debug)"/>
        <arg name="verbose" value="$(arg verbose)"/>
        <arg name="paused" value="$(arg paused)"/>
        <arg name="gui" value="$(arg gui)"/>
        <arg name="respawn_gazebo" value="$(arg respawn_gazebo)"/>
    </include>

    <!-- Spawn the downward-camera UAV at the map origin. -->
    <node name="$(anon vehicle_spawn)" pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-sdf -file $(arg uav_sdf) -model $(arg uav_namespace)
        -x $(arg uav_x) -y $(arg uav_y) -z $(arg uav_z)
        -R $(arg uav_R) -P $(arg uav_P) -Y $(arg uav_Y)"/>

    <!-- Spawn the ground marker at (5, 5). -->
    <node name="$(anon apriltag_spawn)" pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-sdf -file $(arg qr_sdf) -model $(arg qr_model)
        -x $(arg qr_x) -y $(arg qr_y) -z $(arg qr_z)
        -R $(arg qr_R) -P $(arg qr_P) -Y $(arg qr_Y)"/>
</launch>
